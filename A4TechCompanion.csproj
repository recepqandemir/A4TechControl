<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>A4TechCompanion</AssemblyName>
    <RootNamespace>A4TechCompanion</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Product>A4Tech Companion</Product>
    <Company>A4Tech Companion</Company>
    <Description>Windows 11 uyumlu, hafif FG35 / FGK10 yardımcı uygulaması</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
